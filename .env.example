# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Your Telegram user id (get from @userinfobot). Only this user is allowed.
OWNER_ID=123456789

# Neon Postgres connection string. Use the pooled (-pooler) endpoint, sslmode=require.
# Example: postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Timezone (IANA). Default: Europe/Moscow
TZ=Europe/Moscow

# HTTP server port (Render sets this automatically). Default: 8080
PORT=8080

# Public URL of the service on Render (optional, only used in / response)
PUBLIC_URL=https://dayliki.onrender.com
